# --- LLM (Google Gemini) ---
GEMINI_API_KEY=
MODEL_EXTRACT=gemini-3.8-flash
MODEL_JUDGE=gemini-3.8-flash
LLM_MODE=replay                        # live | record | replay (replay needs no key)
LLM_TIMEOUT_SECONDS=45
SEARCH_PROVIDER=gemini                 # gemini | fixture
DAILY_LLM_CALL_CAP=500

# --- Email (Resend) ---
EMAIL_PROVIDER=outbox                  # outbox (store + preview only) | resend
RESEND_API_KEY=
EMAIL_FROM=Vendor Onboarding <onboarding@resend.dev>
EMAIL_REDIRECT_TO=                     # deliver every vendor email here instead (needed until a domain is verified in Resend)

# --- App ---
DATA_DIR=./data
DEMO_PASSWORD=                         # empty = no login (local only)
SESSION_SECRET=                        # set in production so logins survive restarts
SUBMISSIONS_PER_IP_PER_HOUR=60

# --- Thresholds ---
NAME_FUZZY_AMBIGUOUS_LOW=80
NAME_FUZZY_AMBIGUOUS_HIGH=95
SANCTIONS_FUZZY_THRESHOLD=88
RISK_POINTS_REVIEW_THRESHOLD=5
BANK_LETTER_MAX_AGE_DAYS=90
VENDOR_RESPONSE_DUE_DAYS=10
AUTO_CLOSE_DAYS=14
RULE_REVERIFY_DAYS=90
RULE_PROMOTE_AFTER_N_APPROVED=3
MAX_UPLOAD_MB=10
